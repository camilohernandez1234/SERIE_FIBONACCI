<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Serie Fibonacci en JavaScript</title>
</head>
<body>
  <h2>Serie Fibonacci</h2>
  <label for="cantidad">FIBONACCI:</label>
  <input type="number" id="cantidad" value="">
  <button onclick="generarFibonacci()">Generar</button>

  <h3>Resultado:</h3>
  <p id="resultado"></p>

  <script>
    function generarFibonacci() {
      const n = parseInt(document.getElementById('cantidad').value);
      let fib = [0, 1];

      for (let i = 2; i < n; i++) {
        fib[i] = fib[i - 1] + fib[i - 2];
      }

      
      let resultado = n === 0 ? [] : n === 1 ? [0] : fib.slice(0, n);
      
      document.getElementById('resultado').innerText = resultado.join(', ');
    }
  </script>
</body>
</html>
